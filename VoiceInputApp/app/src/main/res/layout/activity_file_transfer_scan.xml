<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF120B08"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/file_scan_left_panel"
        android:layout_width="172dp"
        android:layout_height="match_parent"
        android:background="#F01C120D"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="10dp">

        <Button
            android:id="@+id/file_scan_back"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:background="#FF3A251A"
            android:padding="0dp"
            android:text="返回"
            android:textAllCaps="false"
            android:textColor="#FFFFF7EE"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/file_scan_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="扫码接收文件"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.voiceinput.cimbar.RingProgressView
            android:id="@+id/file_scan_ring_progress"
            android:layout_width="132dp"
            android:layout_height="132dp"
            android:layout_marginTop="18dp" />

        <TextView
            android:id="@+id/file_scan_speed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="速度 0 KB/s"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/file_scan_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="已接收 0 KB / --"
            android:textColor="#FFFFF7EE"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/file_scan_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="对准电脑屏幕上的文件传输图像"
            android:textColor="#FFE8D2BF"
            android:textSize="12sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="#000000">

        <com.voiceinput.cimbar.OpencvCameraView
            android:id="@+id/file_scan_camera1"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.voiceinput.cimbar.OpencvCamera2View
            android:id="@+id/file_scan_camera2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/file_scan_right_panel"
        android:layout_width="236dp"
        android:layout_height="match_parent"
        android:background="#F01C120D"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/file_scan_stats"
            android:layout_width="match_parent"
            android:layout_height="116dp"
            android:fontFamily="monospace"
            android:gravity="top"
            android:includeFontPadding="false"
            android:lineSpacingExtra="0dp"
            android:maxLines="7"
            android:text="等待接收..."
            android:textColor="#FFFFF7EE"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/file_scan_debug"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:gravity="top"
            android:includeFontPadding="false"
            android:lineSpacingExtra="0dp"
            android:maxLines="12"
            android:text="调试信息等待中..."
            android:textColor="#FFE8D2BF"
            android:textSize="9sp" />

        <GridLayout
            android:id="@+id/file_scan_settings_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:paddingTop="8dp">

            <Button
                android:id="@+id/file_scan_camera_api"
                style="@style/ScannerSideButton"
                android:text="C2" />

            <Button
                android:id="@+id/file_scan_camera_fps"
                style="@style/ScannerSideButton"
                android:text="60帧" />

            <Button
                android:id="@+id/file_scan_camera_shutter"
                style="@style/ScannerSideButton"
                android:text="1/200" />

            <Button
                android:id="@+id/file_scan_camera_iso"
                style="@style/ScannerSideButton"
                android:text="ISO200" />

            <Button
                android:id="@+id/file_scan_track_reuse"
                style="@style/ScannerSideButton"
                android:text="全扫" />

            <Button
                android:id="@+id/file_scan_diag"
                style="@style/ScannerSideButton"
                android:text="诊断" />

            <Button
                android:id="@+id/file_scan_reset_params"
                style="@style/ScannerSideButton"
                android:text="重置" />
        </GridLayout>
    </LinearLayout>
</LinearLayout>
